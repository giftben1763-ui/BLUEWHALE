        "base_g": "GAYCUYT553C5LHVE2XPW5GMEJT4BXGM7AHMJWLAPZP53KJO7EIQADRSI",
        "id": "9007199254740992"
      },
      "expected": {
        "mAddress": "MAYCUYT553C5LHVE2XPW5GMEJT4BXGM7AHMJWLAPZP53KJO7EIQACABAAAAAAAAAAAFZG"
      },
      "tags": ["positive", "edge", "interop"]
    },
    {
      "module": "muxed_encode",
      "description": "encode id=2^53+1: above JS safe integer; requires string/BigInt to avoid silent corruption; interop canary",
