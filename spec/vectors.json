{
  "spec_version": "1.2.0",
  "description": "Normative test vectors for the Bluewhale. This file is the single source of truth for routing logic across TypeScript, Go, and Dart implementations. Any change to routing behavior MUST start here.",
  "cases": [
    {
      "module": "muxed_encode",
      "description": "encode id=0: minimum uint64 boundary; ensures zero-padding and no off-by-one in id encoding",
      "input": {
        "base_g": "GAYCUYT553C5LHVE2XPW5GMEJT4BXGM7AHMJWLAPZP53KJO7EIQADRSI",
        "id": "0"
      },
      "expected": {
        "mAddress": "MAYCUYT553C5LHVE2XPW5GMEJT4BXGM7AHMJWLAPZP53KJO7EIQACAAAAAAAAAAAAD672"
      },
      "tags": ["positive", "edge"]
    },
    {
      "module": "muxed_encode",
      "description": "encode id=1: smallest positive id; exercises single-byte id encoding",
      "input": {
        "base_g": "GAYCUYT553C5LHVE2XPW5GMEJT4BXGM7AHMJWLAPZP53KJO7EIQADRSI",
        "id": "1"
      },
      "expected": {
        "mAddress": "MAYCUYT553C5LHVE2XPW5GMEJT4BXGM7AHMJWLAPZP53KJO7EIQACAAAAAAAAAAAAHOO2"
      },
      "tags": ["positive", "edge"]
    },
    {
      "module": "muxed_encode",
